<Window x:Class="leica_watermark_generator.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown">

    <Border Margin="16" Background="{StaticResource B.Panel}" CornerRadius="10"
            BorderBrush="{StaticResource B.Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <StackPanel Margin="22,20,22,18">
            <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" />

            <TextBlock x:Name="MessageText" Margin="0,10,0,0" FontSize="12.5" LineHeight="21"
                       Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource Btn.Small}"
                        Padding="16,7" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource Btn.Primary}"
                        Padding="18,7" Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
